<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.freemytablet"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- After the tablet boots (and after an update), checks that Free My Tablet mode is still as you left it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Termux's permission to run commands (that is where git is). Only asked for when the person uses the
         sync button; the app works without Termux. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- The update: the app downloads the new APK and the system asks the person to install it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ (package visibility): without this the app can't "see" the other apps. The launcher intent is
         the one a launcher needs: every app that can be opened. The HOME intent is what lets the system offer the
         home app role (the dialog to choose the home screen). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:name=".App"
        android:label="Free My Tablet"
        android:icon="@drawable/icon"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <!-- The app's icon opens the settings (switch between Free My Tablet and the original home screen). -->
        <activity
            android:name=".SettingsActivity"
            android:process=":home"
            android:exported="true"
            android:label="Free My Tablet"
            android:launchMode="singleTask"
            android:taskAffinity="io.freemytablet.settings"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/FreeMyTablet.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home screen. Its own process (:home): if it ever crashes, the safety net in the main process still
             works. It only becomes the tablet's home screen in Free My Tablet mode (cmd package set-home-activity). -->
        <activity
            android:name=".HomeActivity"
            android:process=":home"
            android:exported="true"
            android:label="Free My Tablet"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/FreeMyTablet.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The switches, as background jobs in the main process. -->
        <service
            android:name=".ModeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".HomeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The downloaded APK, for the system's installer. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="io.freemytablet.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The widget of the app: the last notes of the Obsidian vault. -->
        <receiver
            android:name=".NotesWidget"
            android:exported="true"
            android:label="@string/widget_notes_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_widget_info" />
        </receiver>
    </application>
</manifest>
